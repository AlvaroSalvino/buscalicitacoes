# Copie para .env e preencha os valores. Nunca commitar o .env real.

# Django
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# Banco de dados
# DB_ENGINE=sqlite (padrão, dev/MVP) ou DB_ENGINE=mysql (produção futura)
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Web Push (VAPID). Gere um par com: python manage.py gerar_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=
